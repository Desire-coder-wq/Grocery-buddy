meta(charset="UTF-8")
meta(name="viewport", content="width=device-width, initial-scale=1")
title Register | My Grocery Buddy

// Bootstrap CSS
link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", rel="stylesheet")

// Custom CSS
link(rel="stylesheet", href="/css/style.css")

// Google Fonts
link(rel="preconnect", href="https://fonts.googleapis.com")
link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap", rel="stylesheet")

// Header
// include ../partials/header 
// You can replace the above with your header HTML if needed

main.container.py-4
  .row.justify-content-center
    .col-md-6.col-lg-5
      .card.mt-5.shadow
        .card-body.p-4
          h2.text-center.mb-4 Register

          // Display error message
          // Example: <div class="alert alert-danger">Error message here</div>

          // Display success message
          // Example: <div class="alert alert-success">Account created!</div>

          form(action="/auth/register", method="POST", enctype="multipart/form-data")
            .mb-3
              label.form-label(for="name") Full Name
              input#name.form-control(type="text", name="name", required)

            .mb-3
              label.form-label(for="email") Email
              input#email.form-control(type="email", name="email", required)

            .mb-3
              label.form-label(for="password") Password
              input#password.form-control(type="password", name="password", required)

            .mb-3
              label.form-label(for="confirmPassword") Confirm Password
              input#confirmPassword.form-control(type="password", name="confirmPassword", required)

            .mb-3
              label.form-label(for="profileImage") Profile Image
              input#profileImage.form-control(type="file", name="profileImage", accept="image/*")

            .d-grid
              button.btn.btn-primary.btn-lg(type="submit") Register

            .text-center.mt-3
              p
                | Already have an account? 
                a(href="/login") Login here

// Bootstrap JS
script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")

// Custom JS
script(src="/js/auth.js")
script(src="/js/grocery.js")
